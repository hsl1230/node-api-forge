{
  "name": "node-api-forge",
  "displayName": "Node API Forge",
  "description": "Discover, test, and document Node APIs without Swagger—no app integration, full testing workflows, pure source-to-API in seconds.",
  "version": "0.1.2",
  "publisher": "henry-huang",
  "icon": "resources/icon.png",
  "license": "MIT",
  "keywords": [
    "swagger alternative",
    "swagger-free",
    "no swagger",
    "http forge",
    "http-forge",
    "http",
    "api",
    "testing",
    "api testing",
    "api development",
    "openapi",
    "swagger",
    "swagger ui",
    "graphql",
    "postman",
    "postman replacement",
    "free postman alternative",
    "thunder client",
    "insomnia",
    "contract testing",
    "openapi generator",
    "rest-client",
    "api-client",
    "http-client",
    "request",
    "collection runner",
    "node",
    "node api",
    "nodejs",
    "express",
    "nestjs",
    "fastify",
    "middleware",
    "flow analysis",
    "api discovery",
    "aws lambda",
    "lambda",
    "serverless"
  ],
  "engines": {
    "vscode": "^1.99.3"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "extensionDependencies": [
    "henry-huang.http-forge"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nodeApiForge.discoverApis",
        "title": "Discover APIs",
        "category": "Node API Forge"
      },
      {
        "command": "nodeApiForge.openEndpointInHttpForge",
        "title": "Open Endpoint in HTTP Forge",
        "category": "Node API Forge"
      },
      {
        "command": "nodeApiForge.openEndpointSource",
        "title": "Open Endpoint Source",
        "category": "Node API Forge"
      },
      {
        "command": "nodeApiForge.copyEndpointRequest",
        "title": "Copy Endpoint Request",
        "category": "Node API Forge"
      },
      {
        "command": "nodeApiForge.exportDiscoveredCollection",
        "title": "Export Discovered Collection",
        "category": "Node API Forge"
      },
      {
        "command": "nodeApiForge.showEndpointFlow",
        "title": "Show Endpoint Flow",
        "category": "Node API Forge",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nodeApiForge.hardRefreshWorkspace",
        "title": "Hard Refresh Workspace",
        "category": "Node API Forge",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "nodeApiForge.searchInEndpoint",
        "title": "Search in Endpoint Files",
        "category": "Node API Forge",
        "icon": "$(search)"
      },
      {
        "command": "nodeApiForge.goToTestFile",
        "title": "Go to Test File",
        "category": "Node API Forge",
        "icon": "$(beaker)"
      },
      {
        "command": "nodeApiForge.exportProjectCollection",
        "title": "Export Project Collection",
        "category": "Node API Forge",
        "icon": "$(export)"
      },
      {
        "command": "nodeApiForge.exportFrameworkCollection",
        "title": "Export Framework Collection",
        "category": "Node API Forge",
        "icon": "$(export)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nodeApiForge",
          "title": "Node API Forge",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "nodeApiForge": [
        {
          "id": "nodeApiForge.apiExplorer",
          "name": "API Explorer",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".http-forge/node-api-forge.config.json",
        "url": "./resources/node-api-forge.config.schema.json"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nodeApiForge.exportDiscoveredCollection",
          "when": "view == nodeApiForge.apiExplorer",
          "group": "navigation",
          "icon": "$(export)"
        },
        {
          "command": "nodeApiForge.hardRefreshWorkspace",
          "when": "view == nodeApiForge.apiExplorer",
          "group": "navigation",
          "icon": "$(sync-ignored)"
        }
      ],
      "view/item/context": [
        {
          "command": "nodeApiForge.showEndpointFlow",
          "when": "view == nodeApiForge.apiExplorer && viewItem == endpoint",
          "group": "inline",
          "icon": "$(type-hierarchy)"
        },
        {
          "command": "nodeApiForge.openEndpointInHttpForge",
          "when": "view == nodeApiForge.apiExplorer && viewItem == endpoint"
        },
        {
          "command": "nodeApiForge.openEndpointSource",
          "when": "view == nodeApiForge.apiExplorer && viewItem == endpoint"
        },
        {
          "command": "nodeApiForge.copyEndpointRequest",
          "when": "view == nodeApiForge.apiExplorer && viewItem == endpoint"
        },
        {
          "command": "nodeApiForge.searchInEndpoint",
          "when": "view == nodeApiForge.apiExplorer && viewItem == endpoint"
        },
        {
          "command": "nodeApiForge.goToTestFile",
          "when": "view == nodeApiForge.apiExplorer && viewItem == endpoint"
        },
        {
          "command": "nodeApiForge.exportProjectCollection",
          "when": "view == nodeApiForge.apiExplorer && viewItem == projectGroup"
        },
        {
          "command": "nodeApiForge.exportFrameworkCollection",
          "when": "view == nodeApiForge.apiExplorer && viewItem == frameworkGroup"
        }
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf out",
    "esbuild-base": "node esbuild.js",
    "build": "npm run esbuild-base",
    "build:dev": "npm run esbuild-base",
    "build:prod": "npm run esbuild-base -- --production",
    "compile": "npm run build:dev",
    "watch": "npm run esbuild-base -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run clean && npm run build:prod && vsce package",
    "prepare": "npm run compile"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hsl1230/node-api-forge"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.99.0",
    "esbuild": "^0.27.0",
    "mermaid": "^11.16.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
